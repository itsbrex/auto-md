{
  "name": "automd-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --format=esm --target=es2022 --outfile=../src/automd/web/static/app.js",
    "check": "tsc --noEmit",
    "dev": "esbuild src/app.ts --bundle --format=esm --target=es2022 --sourcemap --watch --outfile=../src/automd/web/static/app.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}

